# =============================================================================
# Play Flash Cards — Backend env example
# =============================================================================
# Copie para .env e preencha com seus valores REAIS.
# NUNCA commite .env. NUNCA coloque valores reais aqui.
# Gerar segredos: openssl rand -base64 32
# =============================================================================

# ---- Banco de dados -------------------------------------------------------
# Dev: SQLite local
DATABASE_URL="file:./dev.db"
# Prod (Supabase): copiar de Project Settings → Database → Connection string (Direct)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ---- Autenticação ---------------------------------------------------------
# OBRIGATÓRIO em produção. Mínimo 32 caracteres.
# Gerar com: openssl rand -base64 32
JWT_SECRET="REPLACE_ME_WITH_openssl_rand_base64_32"

# ---- URLs -----------------------------------------------------------------
PORT=3001
API_URL=http://localhost:3001
# Para múltiplos domínios: separe por vírgula sem espaços
FRONTEND_URL=http://localhost:5173

# ---- Mercado Pago ---------------------------------------------------------
# Test: TEST-...   Prod: APP_USR-...
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PLAN_PRICE_MONTHLY=19.99
MERCADOPAGO_PLAN_PRICE_ANNUAL=179

# ---- Stripe (opcional — alternativa ao MP) -------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ---- Login social — Google -----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL opcional; default = ${API_URL}/api/auth/google/callback

# ---- Login social — Facebook ---------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- Login social — Apple ------------------------------------------------
# Apple Developer: criar Service ID + Key (Sign in with Apple) + .p8
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ---- E-mail (Resend) ------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ---- IA (English Coach) ---------------------------------------------------
# Provider auto-detectado. Gemini tem prioridade se ambos definidos.
#
# Gemini (Google AI Studio) — FREE tier (sem cartão):
#   Pegar chave: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MEMORY_MODEL=gemini-2.5-flash
#
# OpenAI (alternativa paga, ~US$ 0,15/1M tokens no gpt-4o-mini):
#   Pegar chave: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MEMORY_MODEL=gpt-4o-mini

# ---- Voz HD (ElevenLabs, opcional) ---------------------------------------
# Sem chave, o front cai no Web Speech API (voz nativa do navegador).
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2

# ---- Jobs / Cron ----------------------------------------------------------
# Token forte para autenticar jobs internos via HTTP
# (POST /api/admin/jobs/expire-subscriptions com header x-jobs-secret).
# Gerar com: openssl rand -base64 32
JOBS_SECRET=

# ---- Modo de execução -----------------------------------------------------
# Em produção SEMPRE: NODE_ENV=production
NODE_ENV=development
# Endpoints de simulação de pagamento só sobem se
# NODE_ENV != production E ENABLE_DEV_ENDPOINTS=true.
# Em produção: NÃO definir esta variável (ou deixar vazia).
ENABLE_DEV_ENDPOINTS=false
