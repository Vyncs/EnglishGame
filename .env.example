# Stripe (opcional, alternativo ao Mercado Pago)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Porta da API
PORT=3001

# Frontend URL (CORS, redirect pós-login, back_urls do MP). Em produção use HTTPS (ex: https://seudominio.com)
FRONTEND_URL=https://playgameenglish.netlify.app

# Login social - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL opcional; padrão: API_URL/api/auth/google/callback

# Login social - Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_CALLBACK_URL opcional; padrão: API_URL/api/auth/facebook/callback

# Login social - Apple (Sign in with Apple)
# No Apple Developer: criar Service ID, Key (Sign in with Apple), anotar Team ID, Key ID e baixar .p8
APPLE_CLIENT_ID=          # Service ID (ex: com.yourapp.signin)
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Caminho do arquivo .p8 OU conteúdo da chave (use \n para quebras de linha)
APPLE_PRIVATE_KEY_PATH=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_CALLBACK_URL opcional; padrão: API_URL/api/auth/apple/callback
